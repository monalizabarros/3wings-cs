# Copie para backend.env (ao lado do docker-compose.prod.yml, no servidor).
# NÃO use comentários na mesma linha do valor: o Docker os lê como parte do valor.
# CS_SECRET_KEY: gere com `openssl rand -hex 32`
# CS_ADMIN_PASSWORD: senha forte (só vale na 1ª criação do admin)
# CS_SMTP_PASSWORD: senha de app do Gmail
CS_SECRET_KEY=
CS_ADMIN_EMAIL=admin@3wings.com.br
CS_ADMIN_PASSWORD=
CS_SMTP_HOST=smtp.gmail.com
CS_SMTP_PORT=587
CS_SMTP_USER=monaliza.barros@3wings.com.br
CS_SMTP_PASSWORD=
CS_SMTP_FROM=3Wings CS <monaliza.barros@3wings.com.br>
CS_SMTP_USE_TLS=true
