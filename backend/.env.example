# Copie este arquivo para .env e preencha os valores antes de rodar o backend.
# Gere um valor forte para CS_SECRET_KEY com: openssl rand -hex 32

CS_SECRET_KEY=

# Opcionais — os valores abaixo são os padrões usados se omitidos.
# CS_DATABASE_URL=sqlite:///./cs.db
# CS_ACCESS_TOKEN_EXPIRE_MINUTES=480
# CS_CORS_ORIGINS=http://localhost:5173

# Usados apenas por app/seed.py, na primeira execução (criação do admin).
# CS_ADMIN_EMAIL=admin@3wings.com.br
# CS_ADMIN_PASSWORD=trocar123
# CS_ADMIN_NAME=Administrador

# SMTP para notificação por e-mail de alertas críticos (satisfação negativa,
# risco crítico, renovação em risco). Sem CS_SMTP_HOST, o envio vira um
# no-op logado — não é obrigatório para rodar o app localmente.
# CS_SMTP_HOST=smtp.sendgrid.net
# CS_SMTP_PORT=587
# CS_SMTP_USER=apikey
# CS_SMTP_PASSWORD=
# CS_SMTP_FROM=3Wings CS <no-reply@3wings.com.br>
# CS_SMTP_USE_TLS=true
